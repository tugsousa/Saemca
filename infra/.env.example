# =============================================================================
# SALUSDOMI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# All keys listed here are REQUIRED unless marked (optional).
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Environment: development | staging | production
APP_ENV=development

# Port the Go API listens on
APP_PORT=8080

# Full public URL of the API (no trailing slash)
APP_BASE_URL=http://localhost:8080


# -----------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# -----------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_USER=salusdomi
DB_PASSWORD=changeme
DB_NAME=salusdomi_db

# Max open connections in the pool (recommended: 10-25 for small VPS)
DB_MAX_OPEN_CONNS=10

# Connection string is built from the above — do not set this manually


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# JWT signing secret — must be at least 32 random characters
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-random-256-bit-secret

# How long access tokens live (in minutes)
JWT_EXPIRY_MINUTES=15

# How long refresh tokens live (in days)
REFRESH_TOKEN_EXPIRY_DAYS=30

# Cookie domain (use localhost for dev, your domain for prod)
COOKIE_DOMAIN=localhost

# Set to "true" in production (requires HTTPS)
COOKIE_SECURE=false


# -----------------------------------------------------------------------------
# File Storage — S3-compatible
# Dev: MinIO (Docker)   Prod: Cloudflare R2
# -----------------------------------------------------------------------------

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=salusdomi-uploads
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Cloudflare R2 values for production:
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=<r2-access-key-id>
# STORAGE_SECRET_KEY=<r2-secret-access-key>


# -----------------------------------------------------------------------------
# Payments — Stripe Connect
# -----------------------------------------------------------------------------

# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_replace_me

# Found in Stripe Dashboard → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Platform fee percentage (integer, e.g. 15 = 15%)
STRIPE_PLATFORM_FEE_PERCENT=15


# -----------------------------------------------------------------------------
# Email — Resend
# -----------------------------------------------------------------------------

RESEND_API_KEY=re_replace_me

# "From" address for all outgoing emails (must be verified in Resend)
EMAIL_FROM=noreply@salusdomi.com


# -----------------------------------------------------------------------------
# SMS — Vonage
# -----------------------------------------------------------------------------

VONAGE_API_KEY=replace_me
VONAGE_API_SECRET=replace_me

# Sender name (max 11 chars, shown on recipient's phone)
VONAGE_FROM=Salusdomi


# -----------------------------------------------------------------------------
# Observability — Sentry
# -----------------------------------------------------------------------------

# (optional in development — leave empty to disable)
SENTRY_DSN=

# Sample rate for performance tracing (0.0 to 1.0)
# 0.1 = trace 10% of requests. Start low in production.
SENTRY_TRACES_SAMPLE_RATE=0.1


# -----------------------------------------------------------------------------
# MinIO (development only — object storage local emulator)
# -----------------------------------------------------------------------------

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin


# -----------------------------------------------------------------------------
# Dispute Resolution (configurable — change without code deploys)
# -----------------------------------------------------------------------------

# Hours each party has to submit evidence after a dispute is opened
DISPUTE_EVIDENCE_WINDOW_HOURS=48

# Business days admin has to resolve a dispute before SLA breach
DISPUTE_SLA_BUSINESS_DAYS=5

# Hours after resolution that a party can file an appeal
DISPUTE_APPEAL_WINDOW_HOURS=48

# Hours parties have to accept or decline a mutual resolution proposal
DISPUTE_MUTUAL_ACCEPT_HOURS=24

# Number of disputes LOST before a user is flagged for manual review
# "Lost" = dispute resolved against them. Does not count disputes they won.
DISPUTE_FLAG_THRESHOLD=3
